# KAIRO Environment Variables
# =============================

# Clave de API de Google AI Studio (Gemini) para el tutor de IA.
# Se usa en el servidor (/api/chat, /api/chat-english, /api/extract-questions).
# Nunca uses prefijo VITE_* para esta clave: se expondría en el navegador.
GEMINI_API_KEY=tu_api_key_aqui

# Modelo de Gemini (opcional, por defecto el más rápido/barato)
GEMINI_MODEL=gemini-3.6-flash

# URL del microservicio local de generacion de videos (opcional)
VIDEO_API_URL=http://localhost:8000

# Fuente de datos de preguntas IB (opcional - por defecto usa /data/ib-questions)
# En produccion, apunta a un CDN o backend para evitar el bundle de 3.3GB
# IB_DATA_SOURCE=https://cdn.yourdomain.com/ib-questions

# Modo de depuracion
DEBUG=false