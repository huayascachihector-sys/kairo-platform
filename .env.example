# KAIRO Environment Variables
# =============================

# OpenRouter API key para IA tutor y corrección
OPENROUTER_API_KEY=tu_api_key_aqui

# URL del microservicio local de generación de videos
VIDEO_API_URL=http://localhost:8000

# Fuente de datos de preguntas IB (opcional - por defecto usa /data/ib-questions)
# En producción, apunta a un CDN o backend para evitar el bundle de 3.3GB
# IB_DATA_SOURCE=https://cdn.yourdomain.com/ib-questions

# Modo de depuración
DEBUG=false